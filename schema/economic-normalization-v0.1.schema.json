{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giadaware.local/schema/economic-normalization-v0.1.schema.json",
  "title": "GDI Economic Normalization v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "result", "reasons"],
  "properties": {
    "version": {"const": "0.1"},
    "status": {"enum": ["supported", "unknown"]},
    "result": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["current_price", "quantity", "basis", "comparable_price", "derivation"],
      "properties": {
        "current_price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "currency", "source_path"],
          "properties": {
            "value": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
            "currency": {"const": "EUR"},
            "source_path": {"const": ["price"]}
          }
        },
        "quantity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit", "dimension", "attribute_path", "claim"],
          "properties": {
            "value": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]+)?$"},
            "unit": {"enum": ["g", "ml"]},
            "dimension": {"enum": ["mass", "volume"]},
            "attribute_path": {"enum": [["weight_g"], ["volume_ml"]]},
            "claim": {"type": "object"}
          }
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quantity", "unit", "dimension"],
          "properties": {
            "quantity": {"const": "1"},
            "unit": {"enum": ["kg", "l"]},
            "dimension": {"enum": ["mass", "volume"]}
          }
        },
        "comparable_price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "currency", "per_unit"],
          "properties": {
            "value": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
            "currency": {"const": "EUR"},
            "per_unit": {"enum": ["kg", "l"]}
          }
        },
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule_id", "formula"],
          "properties": {
            "rule_id": {"enum": ["builtin:eur-per-kg:v0.1", "builtin:eur-per-l:v0.1"]},
            "formula": {"enum": ["price_eur * 1000 / weight_g", "price_eur * 1000 / volume_ml"]}
          }
        }
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["code"],
        "properties": {"code": {"type": "string", "minLength": 1}}
      }
    }
  }
}
