{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grocery-offer-v0.1.schema.json",
  "title": "Grocery Offer v0.1",
  "description": "Retailer-neutral representation of a localized, time-bounded, verifiable grocery offer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retailer",
    "product_name",
    "price",
    "currency",
    "validity",
    "locality",
    "verification",
    "provenance"
  ],
  "properties": {
    "retailer": {
      "type": "string",
      "minLength": 1
    },
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Current offer or promotional price presented to the shopper."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "reference_price": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Ordinary or original numeric comparison price for the current offer price. A unit price such as EUR/kg or EUR/L is not a reference_price."
    },
    "packaging_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_price_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "Raw displayed base or original price text preserved from source evidence without requiring generic numeric interpretation."
    },
    "promotion": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "Optional evidence-backed promotion claims. Absence means no canonical promotion claim is asserted, not that no promotion exists.",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "requires_loyalty": {
          "type": "boolean"
        },
        "discount_text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Discount claim exactly as presented by the source; it is not recomputed from price arithmetic."
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "locality": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "scope",
        "stores"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "national",
            "regional",
            "store",
            "unknown"
          ]
        },
        "stores": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "locality_status",
        "evidence_status"
      ],
      "properties": {
        "locality_status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "unknown"
          ]
        },
        "evidence_status": {
          "type": "string",
          "enum": [
            "verified",
            "partial",
            "unmatched",
            "unverified"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_type",
        "source_url",
        "observed_at"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
